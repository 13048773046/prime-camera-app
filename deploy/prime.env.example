PRIME_DEBUG=0
PRIME_DEV_AUTH=0
PRIME_PUBLIC_BASE=https://uosar.yosar.cloud
PRIME_ADMIN_USER=玉玲
# 生产必须改掉；至少 16 位随机字符串
PRIME_ADMIN_PASSWORD=replace-with-a-long-random-password
# 生产必须改掉，用于用户 token 签名
PRIME_AUTH_SECRET=replace-with-a-long-random-secret
# 只允许正式域名与本地调试来源
PRIME_CORS_ORIGINS=https://uosar.yosar.cloud,http://127.0.0.1:8791
# DeepSeek 只负责把结构化构图 brief 改写成流小萤口令；
# 图像几何始终在本地完成，不会把图片发给文本模型。
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=12
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.2
DEEP_ANALYSIS_DAILY_LIMIT=3
COMPOSE_DEDUP_SECONDS=3
MIN_CONFIDENCE=0.35
MAX_IMAGE_BYTES=8388608
TEMPLATE_DIR=static/templates
