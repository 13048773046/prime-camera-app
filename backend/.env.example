PRIME_DEBUG=0
# DeepSeek text model. The image geometry stays local; DeepSeek only writes
# the director's line, so it never receives an unsupported image_url payload.
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=12
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.2
DEEP_ANALYSIS_DAILY_LIMIT=3
COMPOSE_DEDUP_SECONDS=3
MIN_CONFIDENCE=0.35
MAX_IMAGE_BYTES=8388608
TEMPLATE_DIR=static/templates
CORS_ORIGINS=*
